{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "admin-alquileres",
  "version": "0.1.0",
  "identifier": "com.ingma.admin-alquileres",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Admin Alquileres",
        "width": 1200,
        "height": 800,
        "decorations": false, 
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://*.basemaps.cartocdn.com https://*.maptiler.com; connect-src 'self' https://*.basemaps.cartocdn.com;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
